# ── Database ──────────────────────────────────────────────────────────────────
# Pooled/runtime URL (from Vercel Postgres → Connection strings → Prisma)
DATABASE_URL="postgres://..."

# Direct URL for Prisma migrations (from Vercel Postgres → Connection strings → Direct)
DIRECT_URL="postgres://..."

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-in-production

# Must match your deployment URL exactly (production: https://abrahamic.vercel.app)
NEXTAUTH_URL=http://localhost:3000

# ── App ───────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
