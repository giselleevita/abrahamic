# ── Database ──────────────────────────────────────────────────────────────────
# Pooled/runtime URL (for example, a free Neon Postgres pooled connection)
DATABASE_URL="postgres://..."

# Direct/unpooled connection used by Prisma migrations
DIRECT_URL="postgres://..."

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-in-production

# Must match your deployment URL exactly (production: https://abrahamic.vercel.app)
NEXTAUTH_URL=http://localhost:3000

# ── App ───────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
# bcrypt hashes only; never commit a plaintext password
ADMIN_PASSWORD_HASH=

# Optional lower-privilege editorial account. Editors can draft and request
# review but cannot publish, archive, or delete content.
EDITOR_EMAIL=
EDITOR_PASSWORD_HASH=
