# ── Database ──────────────────────────────────────────────────────────────────
# Local development via docker-compose.yml (note: host port is 5434, not 5432)
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/abrahamic"

# Direct URL for Prisma migrations. In production use the Vercel Postgres
# "Direct" connection string; locally it is the same as DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5434/abrahamic"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-in-production

# Must match your deployment URL exactly (production: https://abrahamic.vercel.app)
NEXTAUTH_URL=http://localhost:3000

# ── Admin credentials ─────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com

# bcrypt hash of the admin password — the plaintext is never stored.
# Generate with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_PASSWORD_HASH=

# Optional lower-privilege editorial account. Editors can draft and request
# review but cannot publish, archive, or delete content.
EDITOR_EMAIL=
EDITOR_PASSWORD_HASH=

# ── AI ────────────────────────────────────────────────────────────────────────
# Required by the admin AI tools (summaries, theme suggestions, verse-link
# proposals, kids-story drafts). Routes return 503 when unset, so the rest of
# the app runs without it.
ANTHROPIC_API_KEY=

# ── Content policy ────────────────────────────────────────────────────────────
# Enforces the public-demo translation policy at the Prisma layer: licensed
# English translations are stripped from every query result. Set to "false"
# only for a deployment that holds real translation licences.
PUBLIC_DEMO_MODE=true
