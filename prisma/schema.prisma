generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum SourceKey {
  TORAH
  HEBREW_BIBLE
  NEW_TESTAMENT
  QURAN
  SIRAH_IBN_HISHAM
  HADITH_TRADITION
}

enum Tradition {
  JEWISH
  CHRISTIAN
  ISLAMIC
  SHARED
}

enum ComparisonTag {
  SHARED
  SIMILAR_DIFFERENT
  CONTRADICTION
}

enum VerseLinkType {
  PARALLEL
  CONTRAST
  ELABORATION
  FULFILLMENT_CLAIM
}

enum TranslationLabel {
  ORIGINAL
  CLASSIC
  MODERN
  SCHOLARLY
}

enum InterpretationScope {
  LITERAL
  MAJORITY_SCHOLARLY
  SPECIFIC_TRADITION
}

enum CandidateStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EditorialStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum ConceptCategory {
  THEOLOGY
  SOTERIOLOGY
  ESCHATOLOGY
  PROPHETHOOD
  PRACTICE
  LAW
  COSMOLOGY
}

enum TraditionPresence {
  AFFIRMED
  MODIFIED
  SILENT
  REJECTED
}

enum TimelineEra {
  PRIMORDIAL
  PATRIARCHAL
  EXODUS
  KINGDOM
  GOSPEL
  EARLY_ISLAM
}

enum Versification {
  CHRISTIAN
  MASORETIC
}

enum FigureRelationType {
  PARENT
  CHILD
  SPOUSE
  SIBLING
  DESCENDANT
}

// ─── Source ──────────────────────────────────────────────────────────────────

model Source {
  id          Int       @id @default(autoincrement())
  key         SourceKey @unique
  title       String
  tradition   Tradition
  language    String
  description String?   @db.Text
  slug        String    @unique
  licenseName String
  attribution String    @db.Text
  sourceUrl   String

  verses          Verse[]
  claims          Claim[]
  figureRelations FigureRelation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sources")
}

// ─── Verse ───────────────────────────────────────────────────────────────────

model Verse {
  id       Int    @id @default(autoincrement())
  sourceId Int
  source   Source @relation(fields: [sourceId], references: [id])

  book          String
  bookNumber    Int?
  chapter       Int
  verse         Int
  referenceKey  String        @unique
  versification Versification @default(CHRISTIAN)

  translations      VerseTranslation[]
  claimVerses       ClaimVerse[]
  linksAsA          VerseLink[]          @relation("VerseLinkA")
  linksAsB          VerseLink[]          @relation("VerseLinkB")
  linkCandidatesAsA VerseLinkCandidate[] @relation("CandidateA")
  linkCandidatesAsB VerseLinkCandidate[] @relation("CandidateB")
  timelineVerses    TimelineEventVerse[]
  figureRelations   FigureRelation[]
  questionVerses    QuestionVerse[]
  chapterItems      ChapterItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceId, book, chapter, verse, versification])
  @@index([sourceId, book, chapter])
  @@index([sourceId, book, chapter, versification])
  @@map("verses")
}

model VerseTranslation {
  id           Int                      @id @default(autoincrement())
  verseId      Int
  verse        Verse                    @relation(fields: [verseId], references: [id], onDelete: Cascade)
  label        TranslationLabel
  name         String
  text         String                   @db.Text
  isDefault    Boolean                  @default(false)
  licenseCode  String?
  sourceUrl    String?
  attribution  String?
  retrievedAt  DateTime?
  searchVector Unsupported("tsvector")? @map("search_vector")

  @@unique([verseId, label, name])
  @@index([licenseCode])
  @@map("verse_translations")
}

// ─── Figure ──────────────────────────────────────────────────────────────────

model Figure {
  id            Int     @id @default(autoincrement())
  canonicalName String
  slug          String  @unique
  description   String? @db.Text
  imageUrl      String?
  legacy        String? @db.Text

  aliases        FigureAlias[]
  claims         ClaimFigure[]
  timelineEvents TimelineEventFigure[]
  relationsFrom  FigureRelation[]      @relation("RelationsFrom")
  relationsTo    FigureRelation[]      @relation("RelationsTo")

  chapterItems ChapterItem[]
  kidsStories  KidsStoryFigure[]
  videos       VideoResourceFigure[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("figures")
}

model FigureAlias {
  id        Int       @id @default(autoincrement())
  figureId  Int
  figure    Figure    @relation(fields: [figureId], references: [id], onDelete: Cascade)
  tradition Tradition
  name      String
  language  String?
  notes     String?

  @@unique([figureId, tradition, name])
  @@map("figure_aliases")
}

model FigureRelation {
  id           Int                @id @default(autoincrement())
  fromFigureId Int
  fromFigure   Figure             @relation("RelationsFrom", fields: [fromFigureId], references: [id], onDelete: Cascade)
  toFigureId   Int
  toFigure     Figure             @relation("RelationsTo", fields: [toFigureId], references: [id], onDelete: Cascade)
  relationType FigureRelationType
  notes        String?            @db.Text
  sourceId     Int?
  source       Source?            @relation(fields: [sourceId], references: [id])
  verseId      Int?
  verse        Verse?             @relation(fields: [verseId], references: [id])

  @@unique([fromFigureId, toFigureId, relationType])
  @@map("figure_relations")
}

// ─── Theme ───────────────────────────────────────────────────────────────────

model Theme {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  slug        String  @unique
  description String? @db.Text
  color       String?

  claims ClaimTheme[]
  videos VideoResourceTheme[]

  chapterItems ChapterItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("themes")
}

// ─── Claim ───────────────────────────────────────────────────────────────────

model Claim {
  id       Int    @id @default(autoincrement())
  sourceId Int
  source   Source @relation(fields: [sourceId], references: [id])

  statement           String                   @db.Text
  contentHash         String                   @unique
  notes               String?                  @db.Text
  isPublished         Boolean                  @default(false)
  editorialStatus     EditorialStatus          @default(DRAFT)
  interpretationScope InterpretationScope?
  specificTradition   String?
  embedding           Json?
  searchVector        Unsupported("tsvector")? @map("search_vector")

  /// Bumped (by a database trigger) whenever the statement changes. Reviews are bound to a
  /// revision, so an edit silently voids earlier sign-offs.
  revision           Int         @default(1)
  /// Traditions whose members must confirm they are fairly described before publication.
  /// Derived from the source by `requiredTraditionsFor`; empty only on rows never reviewed.
  requiredTraditions Tradition[] @default([])
  /// Set by an administrator when a tradition's reviewer disagrees and we publish anyway,
  /// showing the disagreement. Reset whenever the revision changes.
  isContested        Boolean     @default(false)
  /// Denormalised per-tradition review state for the current revision, for cheap badges.
  signoffSummary     Json?

  /// Set when a signed-in contributor proposed this claim. Null for staff-authored and seeded claims.
  proposedById  String?
  reports       CorrectionReport[]
  reviews       ClaimReview[]
  verses        ClaimVerse[]
  figures       ClaimFigure[]
  themes        ClaimTheme[]
  comparisons   ComparisonClaim[]
  conceptClaims ConceptClaim[]
  kidsStories   KidsStoryClaim[]

  questions          Question[]
  questionCandidates QuestionCandidate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourceId])
  @@index([isPublished])
  @@index([editorialStatus])
  @@map("claims")
}

model EditorialAuditEvent {
  id         Int      @id @default(autoincrement())
  entityType String
  entityId   String
  action     String
  actorId    String
  actorRole  String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("editorial_audit_events")
}

model ClaimVerse {
  id        Int     @id @default(autoincrement())
  claimId   Int
  claim     Claim   @relation(fields: [claimId], references: [id], onDelete: Cascade)
  verseId   Int
  verse     Verse   @relation(fields: [verseId], references: [id])
  isPrimary Boolean @default(false)

  @@unique([claimId, verseId])
  @@map("claim_verses")
}

model ClaimFigure {
  claimId  Int
  claim    Claim  @relation(fields: [claimId], references: [id], onDelete: Cascade)
  figureId Int
  figure   Figure @relation(fields: [figureId], references: [id])

  @@id([claimId, figureId])
  @@map("claim_figures")
}

model ClaimTheme {
  claimId Int
  claim   Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  themeId Int
  theme   Theme @relation(fields: [themeId], references: [id])

  @@id([claimId, themeId])
  @@map("claim_themes")
}

// ─── Comparison ──────────────────────────────────────────────────────────────

model Comparison {
  id              Int           @id @default(autoincrement())
  title           String
  slug            String        @unique
  tag             ComparisonTag
  summary         String?       @db.Text
  isPublished     Boolean       @default(false)
  isControversial Boolean       @default(false)
  sharedGround    String?       @db.Text
  keyDifferences  String?       @db.Text
  createdById     String?

  claims ComparisonClaim[]

  chapterItems       ChapterItem[]
  questions          Question[]
  questionCandidates QuestionCandidate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tag])
  @@map("comparisons")
}

model ComparisonClaim {
  comparisonId Int
  comparison   Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  claimId      Int
  claim        Claim      @relation(fields: [claimId], references: [id])
  position     Int        @default(0)

  @@id([comparisonId, claimId])
  @@map("comparison_claims")
}

// ─── VerseLink ───────────────────────────────────────────────────────────────

model VerseLink {
  id       Int           @id @default(autoincrement())
  verseAId Int
  verseA   Verse         @relation("VerseLinkA", fields: [verseAId], references: [id])
  verseBId Int
  verseB   Verse         @relation("VerseLinkB", fields: [verseBId], references: [id])
  linkType VerseLinkType
  notes    String?       @db.Text

  @@unique([verseAId, verseBId, linkType])
  @@map("verse_links")
}

model VerseLinkCandidate {
  id          Int             @id @default(autoincrement())
  verseAId    Int
  verseA      Verse           @relation("CandidateA", fields: [verseAId], references: [id])
  verseBId    Int
  verseB      Verse           @relation("CandidateB", fields: [verseBId], references: [id])
  linkType    VerseLinkType
  aiRationale String          @db.Text
  status      CandidateStatus @default(PENDING)
  reviewedAt  DateTime?
  reviewNotes String?         @db.Text

  createdAt DateTime @default(now())

  @@unique([verseAId, verseBId, linkType])
  @@map("verse_link_candidates")
}

// ─── Concept ──────────────────────────────────────────────────────────────────

model Concept {
  id           Int                      @id @default(autoincrement())
  slug         String                   @unique
  name         String                   @unique
  category     ConceptCategory
  summary      String?                  @db.Text
  isPublished  Boolean                  @default(false)
  searchVector Unsupported("tsvector")? @map("search_vector")

  traditions ConceptTradition[]
  claims     ConceptClaim[]
  videos     VideoResourceConcept[]

  chapterItems       ChapterItem[]
  questions          Question[]
  questionCandidates QuestionCandidate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isPublished])
  @@map("concepts")
}

model ConceptTradition {
  id         Int       @id @default(autoincrement())
  conceptId  Int
  concept    Concept   @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  tradition  Tradition
  definition String    @db.Text
  nuances    String?   @db.Text

  @@unique([conceptId, tradition])
  @@map("concept_traditions")
}

model ConceptClaim {
  conceptId Int
  concept   Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  claimId   Int
  claim     Claim   @relation(fields: [claimId], references: [id])
  position  Int     @default(0)

  @@id([conceptId, claimId])
  @@map("concept_claims")
}

// ─── TimelineEvent ────────────────────────────────────────────────────────────

model TimelineEvent {
  id           Int                      @id @default(autoincrement())
  slug         String                   @unique
  name         String
  era          TimelineEra
  position     Int
  summary      String?                  @db.Text
  isPublished  Boolean                  @default(false)
  searchVector Unsupported("tsvector")? @map("search_vector")

  traditions TimelineEventTradition[]
  verses     TimelineEventVerse[]
  figures    TimelineEventFigure[]

  chapterItems       ChapterItem[]
  questions          Question[]
  questionCandidates QuestionCandidate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([era, position])
  @@index([isPublished])
  @@map("timeline_events")
}

model TimelineEventTradition {
  id        Int               @id @default(autoincrement())
  eventId   Int
  event     TimelineEvent     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tradition Tradition
  presence  TraditionPresence
  notes     String?           @db.Text

  @@unique([eventId, tradition])
  @@map("timeline_event_traditions")
}

model TimelineEventVerse {
  eventId Int
  event   TimelineEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  verseId Int
  verse   Verse         @relation(fields: [verseId], references: [id])

  @@id([eventId, verseId])
  @@map("timeline_event_verses")
}

model TimelineEventFigure {
  eventId  Int
  event    TimelineEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  figureId Int
  figure   Figure        @relation(fields: [figureId], references: [id])

  @@id([eventId, figureId])
  @@map("timeline_event_figures")
}

// ═══════════════════════════════════════════════════════════════════════════
// LEARN — courses, chapters and quizzes
// ═══════════════════════════════════════════════════════════════════════════

enum ChapterItemType {
  CONCEPT
  COMPARISON
  FIGURE
  TIMELINE_EVENT
  THEME
  VERSE
}

/// Every kind is ATTRIBUTIVE by construction: the correct answer is a fact
/// about what a named tradition teaches, what a named text says, or where the
/// traditions differ. There is deliberately NO kind whose correct answer is an
/// unattributed truth claim — that absence is the neutrality guarantee.
enum QuestionKind {
  /// "What does <tradition> teach about X?" — requires subjectTradition.
  TRADITION_TEACHING
  /// "In Islamic tradition, who is Isa?" — requires subjectTradition.
  FIGURE_IDENTITY
  /// "According to <source>, what happens?" — requires a verse citation.
  SOURCE_TEXT
  /// "Which traditions affirm X?" — one option per tradition, none scored wrong.
  DIVERGENCE_MAP
  /// Ordering within a named tradition's narrative.
  TIMELINE_ORDER
  /// Definitional; provenance is a Concept.
  TERMINOLOGY
}

enum QuestionFormat {
  SINGLE_CHOICE
  MULTI_SELECT
  /// Never a bare true/false — the stem must attribute ("Islam teaches that…").
  TRUE_FALSE_ATTRIBUTED
  ORDERING
}

enum QuestionSourceType {
  CLAIM
  CONCEPT
  COMPARISON
  TIMELINE_EVENT
}

enum QuestionDifficulty {
  INTRO
  CORE
  DEEP
}

model Course {
  id               Int     @id @default(autoincrement())
  slug             String  @unique
  title            String
  subtitle         String?
  description      String? @db.Text
  position         Int     @default(0)
  isPublished      Boolean @default(false)
  estimatedMinutes Int?
  artworkPath      String?
  artworkAlt       String?
  artworkCredit    String?
  artworkSourceUrl String?
  artworkLicense   String?

  chapters Chapter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, position])
  @@map("courses")
}

model Chapter {
  id       Int    @id @default(autoincrement())
  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  slug              String  @unique
  title             String
  summary           String? @db.Text
  position          Int     @default(0)
  isPublished       Boolean @default(false)
  estimatedMinutes  Int?
  artworkPath       String?
  artworkAlt        String?
  artworkCredit     String?
  artworkSourceUrl  String?
  artworkLicense    String?
  learningObjective String? @db.Text
  takeaway          String? @db.Text

  /// Human sign-off that this chapter's quiz is attributive. Required to
  /// publish — the automated lint is a speed bump, this is the real gate.
  neutralityReviewedAt DateTime?
  neutralityReviewNote String?   @db.Text

  quizQuestionCount Int @default(5)
  quizPassPercent   Int @default(70)

  items      ChapterItem[]
  questions  Question[]
  candidates QuestionCandidate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, position])
  @@index([courseId, position])
  @@index([isPublished])
  @@map("chapters")
}

/// Anonymous daily totals only. No visitor, session, IP, or device columns.
model JourneyMetric {
  day         DateTime @db.Date
  chapterSlug String   @db.VarChar(100)
  count       Int      @default(0)

  @@id([day, chapterSlug])
  @@map("journey_metrics")
}

/// One ordered playlist entry pointing at an existing entity.
///
/// Polymorphism is a discriminator + nullable typed FKs rather than a loose
/// entityId, so referential integrity survives. "Exactly one FK set, and it
/// matches itemType" is enforced by CHECK constraints in the migration SQL.
/// onDelete: Restrict — deleting a cited entity must fail loudly rather than
/// silently gutting a curated chapter.
model ChapterItem {
  id        Int     @id @default(autoincrement())
  chapterId Int
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  itemType ChapterItemType
  position Int             @default(0)
  /// Editorial framing shown above the embedded entity.
  note     String?         @db.Text

  conceptId       Int?
  concept         Concept?       @relation(fields: [conceptId], references: [id], onDelete: Restrict)
  comparisonId    Int?
  comparison      Comparison?    @relation(fields: [comparisonId], references: [id], onDelete: Restrict)
  figureId        Int?
  figure          Figure?        @relation(fields: [figureId], references: [id], onDelete: Restrict)
  timelineEventId Int?
  timelineEvent   TimelineEvent? @relation(fields: [timelineEventId], references: [id], onDelete: Restrict)
  themeId         Int?
  theme           Theme?         @relation(fields: [themeId], references: [id], onDelete: Restrict)
  verseId         Int?
  verse           Verse?         @relation(fields: [verseId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chapterId, position])
  @@index([itemType])
  @@index([verseId])
  @@map("chapter_items")
}

model Question {
  id        Int     @id @default(autoincrement())
  chapterId Int
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  kind       QuestionKind
  format     QuestionFormat     @default(SINGLE_CHOICE)
  difficulty QuestionDifficulty @default(CORE)
  position   Int                @default(0)

  prompt           String     @db.Text
  /// Whose teaching the question is about. Required for TRADITION_TEACHING and
  /// FIGURE_IDENTITY (CHECKed); null for kinds whose citation carries the
  /// attribution instead.
  subjectTradition Tradition?
  /// Required. A question cannot ship without stating why the answer is the
  /// answer; rendered with the provenance citation after answering.
  explanation      String     @db.Text

  isPublished Boolean @default(false)

  // ── provenance: exactly one, CHECKed ──────────────────────────────────
  sourceType      QuestionSourceType
  claimId         Int?
  claim           Claim?             @relation(fields: [claimId], references: [id], onDelete: Restrict)
  conceptId       Int?
  concept         Concept?           @relation(fields: [conceptId], references: [id], onDelete: Restrict)
  comparisonId    Int?
  comparison      Comparison?        @relation(fields: [comparisonId], references: [id], onDelete: Restrict)
  timelineEventId Int?
  timelineEvent   TimelineEvent?     @relation(fields: [timelineEventId], references: [id], onDelete: Restrict)

  /// Denormalised at author time from Comparison.isControversial or
  /// tag = CONTRADICTION. Narrows the allowed kinds and forces every option to
  /// name whose position it is.
  isContested Boolean @default(false)

  originCandidateId    Int?      @unique
  neutralityReviewedAt DateTime?
  neutralityReviewNote String?   @db.Text

  options QuestionAnswerOption[]
  verses  QuestionVerse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chapterId, position])
  @@index([isPublished])
  @@index([kind])
  @@map("questions")
}

model QuestionAnswerOption {
  id         Int      @id @default(autoincrement())
  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  text      String  @db.Text
  isCorrect Boolean @default(false)
  position  Int     @default(0)

  /// DIVERGENCE_MAP: which tradition this option represents and the presence
  /// it asserts, reusing the existing vocabulary so the answer key is
  /// checkable against real ConceptTradition / TimelineEventTradition rows.
  optionTradition Tradition?
  presence        TraditionPresence?

  /// Why this option is not that tradition's teaching. Required on contested
  /// questions so no distractor reads as "this tradition is simply mistaken".
  rationale String? @db.Text

  @@index([questionId, position])
  @@map("question_answer_options")
}

model QuestionVerse {
  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  verseId    Int
  verse      Verse    @relation(fields: [verseId], references: [id], onDelete: Restrict)
  position   Int      @default(0)

  @@id([questionId, verseId])
  @@map("question_verses")
}

/// AI-drafted question awaiting editorial review. Mirrors VerseLinkCandidate.
model QuestionCandidate {
  id        Int     @id @default(autoincrement())
  chapterId Int
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  kind             QuestionKind
  format           QuestionFormat @default(SINGLE_CHOICE)
  prompt           String         @db.Text
  subjectTradition Tradition?
  explanation      String         @db.Text

  sourceType      QuestionSourceType
  claimId         Int?
  claim           Claim?             @relation(fields: [claimId], references: [id])
  conceptId       Int?
  concept         Concept?           @relation(fields: [conceptId], references: [id])
  comparisonId    Int?
  comparison      Comparison?        @relation(fields: [comparisonId], references: [id])
  timelineEventId Int?
  timelineEvent   TimelineEvent?     @relation(fields: [timelineEventId], references: [id])

  /// Draft options as JSON while PENDING: review is a single-row write and a
  /// rejection leaves no orphan rows. Validated by zod on write and on promote.
  /// Shape: { text, isCorrect, optionTradition?, presence?, rationale? }[]
  proposedOptions Json

  aiRationale String  @db.Text
  aiModel     String?
  /// Dedupes re-generation, mirroring Claim.contentHash.
  contentHash String  @unique

  status          CandidateStatus @default(PENDING)
  reviewedAt      DateTime?
  reviewNotes     String?         @db.Text
  /// Result of the automated neutrality lint. A BLOCK flag disables Approve.
  neutralityFlags Json?

  createdAt DateTime @default(now())

  @@index([chapterId, status])
  @@index([status])
  @@map("question_candidates")
}

// ─── Kids section ────────────────────────────────────────────────────────────

enum KidsAgeBand {
  AGE_6_8
  AGE_9_12
}

model KidsStory {
  id          Int             @id @default(autoincrement())
  slug        String          @unique
  title       String
  ageBand     KidsAgeBand
  body        String          @db.Text
  glossary    Json?
  aiModel     String
  aiRationale String          @db.Text
  status      CandidateStatus @default(PENDING)
  reviewedAt  DateTime?
  reviewNotes String?         @db.Text
  isPublished Boolean         @default(false)

  claims  KidsStoryClaim[]
  figures KidsStoryFigure[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([isPublished, ageBand])
  @@map("kids_stories")
}

model KidsStoryClaim {
  storyId  Int
  story    KidsStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  claimId  Int
  claim    Claim     @relation(fields: [claimId], references: [id], onDelete: Cascade)
  position Int       @default(0)

  @@id([storyId, claimId])
  @@map("kids_story_claims")
}

model KidsStoryFigure {
  storyId  Int
  story    KidsStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  figureId Int
  figure   Figure    @relation(fields: [figureId], references: [id], onDelete: Cascade)

  @@id([storyId, figureId])
  @@map("kids_story_figures")
}

// ─── Video resources ─────────────────────────────────────────────────────────

model VideoResource {
  id                   Int        @id @default(autoincrement())
  youtubeId            String     @unique
  title                String
  channelName          String
  editorNote           String     @db.Text
  perspectiveTradition Tradition?
  durationSeconds      Int?
  isPublished          Boolean    @default(false)
  isKidsSafe           Boolean    @default(false)

  concepts VideoResourceConcept[]
  figures  VideoResourceFigure[]
  themes   VideoResourceTheme[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished])
  @@map("video_resources")
}

model VideoResourceConcept {
  videoId   Int
  video     VideoResource @relation(fields: [videoId], references: [id], onDelete: Cascade)
  conceptId Int
  concept   Concept       @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  position  Int           @default(0)

  @@id([videoId, conceptId])
  @@map("video_resource_concepts")
}

model VideoResourceFigure {
  videoId  Int
  video    VideoResource @relation(fields: [videoId], references: [id], onDelete: Cascade)
  figureId Int
  figure   Figure        @relation(fields: [figureId], references: [id], onDelete: Cascade)
  position Int           @default(0)

  @@id([videoId, figureId])
  @@map("video_resource_figures")
}

model VideoResourceTheme {
  videoId  Int
  video    VideoResource @relation(fields: [videoId], references: [id], onDelete: Cascade)
  themeId  Int
  theme    Theme         @relation(fields: [themeId], references: [id], onDelete: Cascade)
  position Int           @default(0)

  @@id([videoId, themeId])
  @@map("video_resource_themes")
}

/// Failed-login counters for brute-force protection. The key is a SHA-256 hash
/// of "email:<address>" or "ip:<address>", so no raw email or IP is stored.
/// DB-backed because serverless instances do not share memory.
model LoginAttempt {
  key         String    @id @db.VarChar(64)
  failures    Int       @default(0)
  windowStart DateTime
  lockedUntil DateTime?

  @@map("login_attempts")
}

// ─── Accounts & reviewer verification ────────────────────────────────────────
// Contributors sign in with an OAuth provider. Identity is (provider, providerAccountId),
// never email, so an unverified provider email cannot take over another account.
// ADMIN is deliberately not a role here: it exists only as environment credentials,
// so nothing in the database can mint an administrator.

enum UserRole {
  CONTRIBUTOR
  EDITOR
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ReviewerStatus {
  PENDING
  APPROVED
  REVOKED
}

model User {
  id                String     @id @default(cuid())
  provider          String     @db.VarChar(20)
  providerAccountId String     @db.VarChar(100)
  email             String?
  displayName       String?
  role              UserRole   @default(CONTRIBUTOR)
  status            UserStatus @default(ACTIVE)
  createdAt         DateTime   @default(now())
  lastSignInAt      DateTime   @default(now())

  reviewerProfiles ReviewerProfile[]

  @@unique([provider, providerAccountId])
  @@map("users")
}

/// A user's request to review on behalf of one tradition. Approval is a human
/// decision by an administrator. Never SHARED (CHECK constraint in the migration).
model ReviewerProfile {
  id          Int            @id @default(autoincrement())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradition   Tradition
  affiliation String         @db.VarChar(200)
  statement   String         @db.Text
  status      ReviewerStatus @default(PENDING)
  decidedBy   String?
  decidedAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([userId, tradition])
  @@index([status])
  @@map("reviewer_profiles")
}

// ─── Tradition sign-off ──────────────────────────────────────────────────────
// A claim may only become PUBLISHED when, for every tradition in `requiredTraditions`,
// a reviewer has recorded ACCURATE for the CURRENT revision. Enforced by a trigger in the
// migration (the API pre-checks only to give friendly errors).

enum ReviewVerdict {
  ACCURATE
  NEEDS_CHANGES
  OBJECTS
}

/// TRADITION_MEMBER: an administrator-approved reviewer who belongs to that tradition.
/// PROJECT_EDITOR: the project's administrator standing in until a member reviews. It
/// satisfies the publishing gate but is always labelled as such, never as a member review.
enum ReviewerKind {
  TRADITION_MEMBER
  PROJECT_EDITOR
}

model ClaimReview {
  id         Int           @id @default(autoincrement())
  claimId    Int
  claim      Claim         @relation(fields: [claimId], references: [id], onDelete: Cascade)
  revision   Int
  tradition  Tradition
  kind       ReviewerKind
  /// User id, or "admin" for the environment administrator. Not a foreign key, so
  /// deleting an account never deletes the review record (it simply becomes anonymous).
  reviewerId String
  verdict    ReviewVerdict
  comment    String?       @db.Text
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([claimId, revision, tradition, reviewerId])
  @@index([claimId, revision])
  @@map("claim_reviews")
}

// ─── Public correction reports ───────────────────────────────────────────────
// Anyone may tell us something is wrong, with no account. Reports are input for editors, never
// a vote and never a path to publication. The reporter's IP is stored only as a keyed hash, for
// rate limiting, and is blanked after 30 days.

enum ReportKind {
  CORRECTION
  UNFAIR_TO_TRADITION
  SOURCE_ERROR
  OTHER
}

enum ReportStatus {
  NEW
  SEEN
  ACTIONED
  DISMISSED
}

model CorrectionReport {
  id             Int          @id @default(autoincrement())
  kind           ReportKind
  claimId        Int?
  claim          Claim?       @relation(fields: [claimId], references: [id], onDelete: SetNull)
  pagePath       String?      @db.VarChar(2000)
  reference      String?      @db.VarChar(300)
  message        String       @db.Text
  legacyCategory String?      @db.VarChar(30)
  contactEmail   String?      @db.VarChar(254)
  ipHash         String       @db.VarChar(64)
  status         ReportStatus @default(NEW)
  handledBy      String?
  handledAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([ipHash, createdAt])
  @@map("correction_reports")
}

/// Anonymous, keyed request digests only. Expired windows are removed in bounded batches.
model CorrectionRateBucket {
  keyDigest   String   @db.Char(64)
  windowStart DateTime
  count       Int      @default(1)

  @@id([keyDigest, windowStart])
  @@index([windowStart])
  @@map("correction_rate_buckets")
}
