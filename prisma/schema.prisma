generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum SourceKey {
  TORAH
  HEBREW_BIBLE
  NEW_TESTAMENT
  QURAN
  SIRAH_IBN_HISHAM
  HADITH_TRADITION
}

enum Tradition {
  JEWISH
  CHRISTIAN
  ISLAMIC
  SHARED
}

enum ComparisonTag {
  SHARED
  SIMILAR_DIFFERENT
  CONTRADICTION
}

enum VerseLinkType {
  PARALLEL
  CONTRAST
  ELABORATION
  FULFILLMENT_CLAIM
}

enum TranslationLabel {
  ORIGINAL
  CLASSIC
  MODERN
  SCHOLARLY
}

enum InterpretationScope {
  LITERAL
  MAJORITY_SCHOLARLY
  SPECIFIC_TRADITION
}

enum CandidateStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ConceptCategory {
  THEOLOGY
  SOTERIOLOGY
  ESCHATOLOGY
  PROPHETHOOD
  PRACTICE
  LAW
  COSMOLOGY
}

enum TraditionPresence {
  AFFIRMED
  MODIFIED
  SILENT
  REJECTED
}

enum TimelineEra {
  PRIMORDIAL
  PATRIARCHAL
  EXODUS
  KINGDOM
  GOSPEL
  EARLY_ISLAM
}

enum FigureRelationType {
  PARENT
  CHILD
  SPOUSE
  SIBLING
  DESCENDANT
}

// ─── Source ──────────────────────────────────────────────────────────────────

model Source {
  id          Int       @id @default(autoincrement())
  key         SourceKey @unique
  title       String
  tradition   Tradition
  language    String
  description String?   @db.Text
  slug        String    @unique

  verses Verse[]
  claims Claim[]
  figureRelations FigureRelation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sources")
}

// ─── Verse ───────────────────────────────────────────────────────────────────

model Verse {
  id       Int    @id @default(autoincrement())
  sourceId Int
  source   Source @relation(fields: [sourceId], references: [id])

  book         String
  bookNumber   Int?
  chapter      Int
  verse        Int
  referenceKey String @unique

  translations      VerseTranslation[]
  claimVerses       ClaimVerse[]
  linksAsA          VerseLink[]            @relation("VerseLinkA")
  linksAsB          VerseLink[]            @relation("VerseLinkB")
  linkCandidatesAsA VerseLinkCandidate[]   @relation("CandidateA")
  linkCandidatesAsB VerseLinkCandidate[]   @relation("CandidateB")
  timelineVerses    TimelineEventVerse[]
  figureRelations   FigureRelation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceId, book, chapter, verse])
  @@index([sourceId, book, chapter])
  @@map("verses")
}

model VerseTranslation {
  id        Int              @id @default(autoincrement())
  verseId   Int
  verse     Verse            @relation(fields: [verseId], references: [id], onDelete: Cascade)
  label     TranslationLabel
  name      String
  text      String           @db.Text
  isDefault Boolean          @default(false)

  @@unique([verseId, label, name])
  @@map("verse_translations")
}

// ─── Figure ──────────────────────────────────────────────────────────────────

model Figure {
  id            Int     @id @default(autoincrement())
  canonicalName String
  slug          String  @unique
  description   String? @db.Text
  imageUrl      String?
  legacy        String? @db.Text

  aliases         FigureAlias[]
  claims          ClaimFigure[]
  timelineEvents  TimelineEventFigure[]
  relationsFrom   FigureRelation[] @relation("RelationsFrom")
  relationsTo     FigureRelation[] @relation("RelationsTo")
  kidsStories     KidsStoryFigure[]
  videos          VideoResourceFigure[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("figures")
}

model FigureAlias {
  id        Int       @id @default(autoincrement())
  figureId  Int
  figure    Figure    @relation(fields: [figureId], references: [id], onDelete: Cascade)
  tradition Tradition
  name      String
  language  String?
  notes     String?

  @@unique([figureId, tradition, name])
  @@map("figure_aliases")
}

model FigureRelation {
  id            Int               @id @default(autoincrement())
  fromFigureId  Int
  fromFigure    Figure            @relation("RelationsFrom", fields: [fromFigureId], references: [id], onDelete: Cascade)
  toFigureId    Int
  toFigure      Figure            @relation("RelationsTo", fields: [toFigureId], references: [id], onDelete: Cascade)
  relationType  FigureRelationType
  notes         String?           @db.Text
  sourceId      Int?
  source        Source?           @relation(fields: [sourceId], references: [id])
  verseId       Int?
  verse         Verse?            @relation(fields: [verseId], references: [id])

  @@unique([fromFigureId, toFigureId, relationType])
  @@map("figure_relations")
}

// ─── Theme ───────────────────────────────────────────────────────────────────

model Theme {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  slug        String  @unique
  description String? @db.Text
  color       String?

  claims ClaimTheme[]
  videos VideoResourceTheme[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("themes")
}

// ─── Claim ───────────────────────────────────────────────────────────────────

model Claim {
  id       Int    @id @default(autoincrement())
  sourceId Int
  source   Source @relation(fields: [sourceId], references: [id])

  statement           String               @db.Text
  contentHash         String               @unique
  notes               String?              @db.Text
  isPublished         Boolean              @default(false)
  interpretationScope InterpretationScope?
  specificTradition   String?
  embedding           Json?

  verses        ClaimVerse[]
  figures       ClaimFigure[]
  /// Generated tsvector maintained by Postgres. Declared so Prisma does not
  /// report schema drift; Unsupported keeps it out of the generated client,
  /// which is correct — a generated column must never be written.
  searchVector Unsupported("tsvector")? @map("search_vector")

  themes        ClaimTheme[]
  comparisons   ComparisonClaim[]
  conceptClaims ConceptClaim[]
  kidsStories   KidsStoryClaim[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourceId])
  @@index([isPublished])
  @@map("claims")
}

model ClaimVerse {
  id        Int     @id @default(autoincrement())
  claimId   Int
  claim     Claim   @relation(fields: [claimId], references: [id], onDelete: Cascade)
  verseId   Int
  verse     Verse   @relation(fields: [verseId], references: [id])
  isPrimary Boolean @default(false)

  @@unique([claimId, verseId])
  @@map("claim_verses")
}

model ClaimFigure {
  claimId  Int
  claim    Claim  @relation(fields: [claimId], references: [id], onDelete: Cascade)
  figureId Int
  figure   Figure @relation(fields: [figureId], references: [id])

  @@id([claimId, figureId])
  @@map("claim_figures")
}

model ClaimTheme {
  claimId Int
  claim   Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  themeId Int
  theme   Theme @relation(fields: [themeId], references: [id])

  @@id([claimId, themeId])
  @@map("claim_themes")
}

// ─── Comparison ──────────────────────────────────────────────────────────────

model Comparison {
  id              Int           @id @default(autoincrement())
  title           String
  slug            String        @unique
  tag             ComparisonTag
  summary         String?       @db.Text
  isPublished     Boolean       @default(false)
  isControversial Boolean       @default(false)
  createdById     String?

  claims ComparisonClaim[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tag])
  @@map("comparisons")
}

model ComparisonClaim {
  comparisonId Int
  comparison   Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  claimId      Int
  claim        Claim      @relation(fields: [claimId], references: [id])
  position     Int        @default(0)

  @@id([comparisonId, claimId])
  @@map("comparison_claims")
}

// ─── VerseLink ───────────────────────────────────────────────────────────────

model VerseLink {
  id       Int           @id @default(autoincrement())
  verseAId Int
  verseA   Verse         @relation("VerseLinkA", fields: [verseAId], references: [id])
  verseBId Int
  verseB   Verse         @relation("VerseLinkB", fields: [verseBId], references: [id])
  linkType VerseLinkType
  notes    String?       @db.Text

  @@unique([verseAId, verseBId, linkType])
  @@map("verse_links")
}

model VerseLinkCandidate {
  id           Int             @id @default(autoincrement())
  verseAId     Int
  verseA       Verse           @relation("CandidateA", fields: [verseAId], references: [id])
  verseBId     Int
  verseB       Verse           @relation("CandidateB", fields: [verseBId], references: [id])
  linkType     VerseLinkType
  aiRationale  String          @db.Text
  status       CandidateStatus @default(PENDING)
  reviewedAt   DateTime?
  reviewNotes  String?         @db.Text

  createdAt DateTime @default(now())

  @@unique([verseAId, verseBId, linkType])
  @@map("verse_link_candidates")
}

// ─── Concept ──────────────────────────────────────────────────────────────────

model Concept {
  id          Int             @id @default(autoincrement())
  slug        String          @unique
  name        String          @unique
  category    ConceptCategory
  summary     String?         @db.Text
  isPublished Boolean         @default(false)

  /// Generated tsvector maintained by Postgres. Declared so Prisma does not
  /// report schema drift; Unsupported keeps it out of the generated client,
  /// which is correct — a generated column must never be written.
  searchVector Unsupported("tsvector")? @map("search_vector")

  traditions ConceptTradition[]
  videos     VideoResourceConcept[]
  claims     ConceptClaim[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isPublished])
  @@map("concepts")
}

model ConceptTradition {
  id         Int       @id @default(autoincrement())
  conceptId  Int
  concept    Concept   @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  tradition  Tradition
  definition String    @db.Text
  nuances    String?   @db.Text

  @@unique([conceptId, tradition])
  @@map("concept_traditions")
}

model ConceptClaim {
  conceptId Int
  concept   Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  claimId   Int
  claim     Claim   @relation(fields: [claimId], references: [id])
  position  Int     @default(0)

  @@id([conceptId, claimId])
  @@map("concept_claims")
}

// ─── TimelineEvent ────────────────────────────────────────────────────────────

model TimelineEvent {
  id          Int         @id @default(autoincrement())
  slug        String      @unique
  name        String
  era         TimelineEra
  position    Int
  summary     String?     @db.Text
  isPublished Boolean     @default(false)

  /// Generated tsvector maintained by Postgres. Declared so Prisma does not
  /// report schema drift; Unsupported keeps it out of the generated client,
  /// which is correct — a generated column must never be written.
  searchVector Unsupported("tsvector")? @map("search_vector")

  traditions TimelineEventTradition[]
  verses     TimelineEventVerse[]
  figures    TimelineEventFigure[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([era, position])
  @@index([isPublished])
  @@map("timeline_events")
}

model TimelineEventTradition {
  id        Int               @id @default(autoincrement())
  eventId   Int
  event     TimelineEvent     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tradition Tradition
  presence  TraditionPresence
  notes     String?           @db.Text

  @@unique([eventId, tradition])
  @@map("timeline_event_traditions")
}

model TimelineEventVerse {
  eventId Int
  event   TimelineEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  verseId Int
  verse   Verse         @relation(fields: [verseId], references: [id])

  @@id([eventId, verseId])
  @@map("timeline_event_verses")
}

model TimelineEventFigure {
  eventId  Int
  event    TimelineEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  figureId Int
  figure   Figure        @relation(fields: [figureId], references: [id])

  @@id([eventId, figureId])
  @@map("timeline_event_figures")
}

// ─── Kids section ────────────────────────────────────────────────────────────
// Child-facing retellings drafted from already-published claims and released
// only by explicit admin approval. Reuses CandidateStatus so the review flow
// matches VerseLinkCandidate.

enum KidsAgeBand {
  AGE_6_8
  AGE_9_12
}

model KidsStory {
  id          Int             @id @default(autoincrement())
  slug        String          @unique
  title       String
  ageBand     KidsAgeBand
  body        String          @db.Text
  /// [{ term, plainDefinition }] — editor-editable plain-language glossary.
  glossary    Json?
  /// Provenance: the model that drafted this, or "hand-authored" for seeds.
  aiModel     String
  aiRationale String          @db.Text
  status      CandidateStatus @default(PENDING)
  reviewedAt  DateTime?
  reviewNotes String?         @db.Text
  /// Approval and publication are deliberately separate steps for child-facing
  /// content. A DB CHECK constraint forbids isPublished on an unapproved row.
  isPublished Boolean         @default(false)

  claims  KidsStoryClaim[]
  figures KidsStoryFigure[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([isPublished, ageBand])
  @@map("kids_stories")
}

/// Provenance chain: a story may only be drafted from published claims, and the
/// public page cites them, keeping kids content inside the "every claim is
/// sourced" editorial principle.
model KidsStoryClaim {
  storyId  Int
  story    KidsStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  claimId  Int
  claim    Claim     @relation(fields: [claimId], references: [id], onDelete: Cascade)
  position Int       @default(0)

  @@id([storyId, claimId])
  @@map("kids_story_claims")
}

model KidsStoryFigure {
  storyId  Int
  story    KidsStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  figureId Int
  figure   Figure    @relation(fields: [figureId], references: [id], onDelete: Cascade)

  @@id([storyId, figureId])
  @@map("kids_story_figures")
}

// ─── Video resources ─────────────────────────────────────────────────────────
// Third-party explainer videos, added one at a time by an editor. There is no
// search or channel-wide import: nothing renders that a person did not
// individually approve.

model VideoResource {
  id          Int     @id @default(autoincrement())
  /// The 11-character YouTube id. Validated by regex before storage — the
  /// embed URL is built by interpolation, so an unchecked value is an
  /// iframe-src injection.
  youtubeId   String  @unique
  title       String
  channelName String
  /// Required, and non-trivial: an editor must state in writing why this video
  /// is here. Embedding an outside voice on a neutrality-critical platform
  /// should never be a silent act.
  editorNote  String  @db.Text
  /// Whose reading this video represents, when it clearly represents one. Lets
  /// an editor see at a glance when a topic's videos all come from one side.
  perspectiveTradition Tradition?
  durationSeconds Int?
  isPublished Boolean @default(false)
  /// Separate from isPublished on purpose: an adult-vetted lecture is not
  /// automatically suitable for the kids section.
  isKidsSafe  Boolean @default(false)

  concepts VideoResourceConcept[]
  figures  VideoResourceFigure[]
  themes   VideoResourceTheme[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished])
  @@map("video_resources")
}

model VideoResourceConcept {
  videoId   Int
  video     VideoResource @relation(fields: [videoId], references: [id], onDelete: Cascade)
  conceptId Int
  concept   Concept       @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  position  Int           @default(0)

  @@id([videoId, conceptId])
  @@map("video_resource_concepts")
}

model VideoResourceFigure {
  videoId  Int
  video    VideoResource @relation(fields: [videoId], references: [id], onDelete: Cascade)
  figureId Int
  figure   Figure        @relation(fields: [figureId], references: [id], onDelete: Cascade)
  position Int           @default(0)

  @@id([videoId, figureId])
  @@map("video_resource_figures")
}

model VideoResourceTheme {
  videoId  Int
  video    VideoResource @relation(fields: [videoId], references: [id], onDelete: Cascade)
  themeId  Int
  theme    Theme         @relation(fields: [themeId], references: [id], onDelete: Cascade)
  position Int           @default(0)

  @@id([videoId, themeId])
  @@map("video_resource_themes")
}
