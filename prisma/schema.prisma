generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum SourceKey {
  TORAH
  HEBREW_BIBLE
  NEW_TESTAMENT
  QURAN
  SIRAH_IBN_HISHAM
  HADITH_TRADITION
}

enum Tradition {
  JEWISH
  CHRISTIAN
  ISLAMIC
  SHARED
}

enum ComparisonTag {
  SHARED
  SIMILAR_DIFFERENT
  CONTRADICTION
}

enum VerseLinkType {
  PARALLEL
  CONTRAST
  ELABORATION
  FULFILLMENT_CLAIM
}

enum TranslationLabel {
  ORIGINAL
  CLASSIC
  MODERN
  SCHOLARLY
}

enum InterpretationScope {
  LITERAL
  MAJORITY_SCHOLARLY
  SPECIFIC_TRADITION
}

enum CandidateStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EditorialStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum ConceptCategory {
  THEOLOGY
  SOTERIOLOGY
  ESCHATOLOGY
  PROPHETHOOD
  PRACTICE
  LAW
  COSMOLOGY
}

enum TraditionPresence {
  AFFIRMED
  MODIFIED
  SILENT
  REJECTED
}

enum TimelineEra {
  PRIMORDIAL
  PATRIARCHAL
  EXODUS
  KINGDOM
  GOSPEL
  EARLY_ISLAM
}

enum Versification {
  CHRISTIAN
  MASORETIC
}

enum FigureRelationType {
  PARENT
  CHILD
  SPOUSE
  SIBLING
  DESCENDANT
}

// ─── Source ──────────────────────────────────────────────────────────────────

model Source {
  id          Int       @id @default(autoincrement())
  key         SourceKey @unique
  title       String
  tradition   Tradition
  language    String
  description String?   @db.Text
  slug        String    @unique
  licenseName String
  attribution String    @db.Text
  sourceUrl   String

  verses          Verse[]
  claims          Claim[]
  figureRelations FigureRelation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sources")
}

// ─── Verse ───────────────────────────────────────────────────────────────────

model Verse {
  id       Int    @id @default(autoincrement())
  sourceId Int
  source   Source @relation(fields: [sourceId], references: [id])

  book          String
  bookNumber    Int?
  chapter       Int
  verse         Int
  referenceKey  String        @unique
  versification Versification @default(CHRISTIAN)

  translations      VerseTranslation[]
  claimVerses       ClaimVerse[]
  linksAsA          VerseLink[]          @relation("VerseLinkA")
  linksAsB          VerseLink[]          @relation("VerseLinkB")
  linkCandidatesAsA VerseLinkCandidate[] @relation("CandidateA")
  linkCandidatesAsB VerseLinkCandidate[] @relation("CandidateB")
  timelineVerses    TimelineEventVerse[]
  figureRelations   FigureRelation[]
  questionVerses    QuestionVerse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceId, book, chapter, verse, versification])
  @@index([sourceId, book, chapter])
  @@index([sourceId, book, chapter, versification])
  @@map("verses")
}

model VerseTranslation {
  id           Int                      @id @default(autoincrement())
  verseId      Int
  verse        Verse                    @relation(fields: [verseId], references: [id], onDelete: Cascade)
  label        TranslationLabel
  name         String
  text         String                   @db.Text
  isDefault    Boolean                  @default(false)
  licenseCode  String?
  sourceUrl    String?
  attribution  String?
  retrievedAt  DateTime?
  searchVector Unsupported("tsvector")? @map("search_vector")

  @@unique([verseId, label, name])
  @@index([licenseCode])
  @@map("verse_translations")
}

// ─── Figure ──────────────────────────────────────────────────────────────────

model Figure {
  id            Int     @id @default(autoincrement())
  canonicalName String
  slug          String  @unique
  description   String? @db.Text
  imageUrl      String?
  legacy        String? @db.Text

  aliases        FigureAlias[]
  claims         ClaimFigure[]
  timelineEvents TimelineEventFigure[]
  relationsFrom  FigureRelation[]      @relation("RelationsFrom")
  relationsTo    FigureRelation[]      @relation("RelationsTo")

  chapterItems ChapterItem[]
  kidsStories  KidsStoryFigure[]
  videos       VideoResourceFigure[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("figures")
}

model FigureAlias {
  id        Int       @id @default(autoincrement())
  figureId  Int
  figure    Figure    @relation(fields: [figureId], references: [id], onDelete: Cascade)
  tradition Tradition
  name      String
  language  String?
  notes     String?

  @@unique([figureId, tradition, name])
  @@map("figure_aliases")
}

model FigureRelation {
  id           Int                @id @default(autoincrement())
  fromFigureId Int
  fromFigure   Figure             @relation("RelationsFrom", fields: [fromFigureId], references: [id], onDelete: Cascade)
  toFigureId   Int
  toFigure     Figure             @relation("RelationsTo", fields: [toFigureId], references: [id], onDelete: Cascade)
  relationType FigureRelationType
  notes        String?            @db.Text
  sourceId     Int?
  source       Source?            @relation(fields: [sourceId], references: [id])
  verseId      Int?
  verse        Verse?             @relation(fields: [verseId], references: [id])

  @@unique([fromFigureId, toFigureId, relationType])
  @@map("figure_relations")
}

// ─── Theme ───────────────────────────────────────────────────────────────────

model Theme {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  slug        String  @unique
  description String? @db.Text
  color       String?

  claims ClaimTheme[]
  videos VideoResourceTheme[]

  chapterItems ChapterItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("themes")
}

// ─── Claim ───────────────────────────────────────────────────────────────────

model Claim {
  id       Int    @id @default(autoincrement())
  sourceId Int
  source   Source @relation(fields: [sourceId], references: [id])

  statement           String                   @db.Text
  contentHash         String                   @unique
  notes               String?                  @db.Text
  isPublished         Boolean                  @default(false)
  editorialStatus     EditorialStatus          @default(DRAFT)
  interpretationScope InterpretationScope?
  specificTradition   String?
  embedding           Json?
  searchVector        Unsupported("tsvector")? @map("search_vector")

  verses        ClaimVerse[]
  figures       ClaimFigure[]
  themes        ClaimTheme[]
  comparisons   ComparisonClaim[]
  conceptClaims ConceptClaim[]
  kidsStories   KidsStoryClaim[]

  questions          Question[]
  questionCandidates QuestionCandidate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourceId])
  @@index([isPublished])
  @@index([editorialStatus])
  @@map("claims")
}

model EditorialAuditEvent {
  id         Int      @id @default(autoincrement())
  entityType String
  entityId   String
  action     String
  actorId    String
  actorRole  String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("editorial_audit_events")
}

model ClaimVerse {
  id        Int     @id @default(autoincrement())
  claimId   Int
  claim     Claim   @relation(fields: [claimId], references: [id], onDelete: Cascade)
  verseId   Int
  verse     Verse   @relation(fields: [verseId], references: [id])
  isPrimary Boolean @default(false)

  @@unique([claimId, verseId])
  @@map("claim_verses")
}

model ClaimFigure {
  claimId  Int
  claim    Claim  @relation(fields: [claimId], references: [id], onDelete: Cascade)
  figureId Int
  figure   Figure @relation(fields: [figureId], references: [id])

  @@id([claimId, figureId])
  @@map("claim_figures")
}

model ClaimTheme {
  claimId Int
  claim   Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  themeId Int
  theme   Theme @relation(fields: [themeId], references: [id])

  @@id([claimId, themeId])
  @@map("claim_themes")
}

// ─── Comparison ──────────────────────────────────────────────────────────────

model Comparison {
  id              Int           @id @default(autoincrement())
  title           String
  slug            String        @unique
  tag             ComparisonTag
  summary         String?       @db.Text
  isPublished     Boolean       @default(false)
  isControversial Boolean       @default(false)
  createdById     String?

  claims ComparisonClaim[]

  chapterItems       ChapterItem[]
  questions          Question[]
  questionCandidates QuestionCandidate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tag])
  @@map("comparisons")
}

model ComparisonClaim {
  comparisonId Int
  comparison   Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  claimId      Int
  claim        Claim      @relation(fields: [claimId], references: [id])
  position     Int        @default(0)

  @@id([comparisonId, claimId])
  @@map("comparison_claims")
}

// ─── VerseLink ───────────────────────────────────────────────────────────────

model VerseLink {
  id       Int           @id @default(autoincrement())
  verseAId Int
  verseA   Verse         @relation("VerseLinkA", fields: [verseAId], references: [id])
  verseBId Int
  verseB   Verse         @relation("VerseLinkB", fields: [verseBId], references: [id])
  linkType VerseLinkType
  notes    String?       @db.Text

  @@unique([verseAId, verseBId, linkType])
  @@map("verse_links")
}

model VerseLinkCandidate {
  id          Int             @id @default(autoincrement())
  verseAId    Int
  verseA      Verse           @relation("CandidateA", fields: [verseAId], references: [id])
  verseBId    Int
  verseB      Verse           @relation("CandidateB", fields: [verseBId], references: [id])
  linkType    VerseLinkType
  aiRationale String          @db.Text
  status      CandidateStatus @default(PENDING)
  reviewedAt  DateTime?
  reviewNotes String?         @db.Text

  createdAt DateTime @default(now())

  @@unique([verseAId, verseBId, linkType])
  @@map("verse_link_candidates")
}

// ─── Concept ──────────────────────────────────────────────────────────────────

model Concept {
  id           Int                      @id @default(autoincrement())
  slug         String                   @unique
  name         String                   @unique
  category     ConceptCategory
  summary      String?                  @db.Text
  isPublished  Boolean                  @default(false)
  searchVector Unsupported("tsvector")? @map("search_vector")

  traditions ConceptTradition[]
  claims     ConceptClaim[]
  videos     VideoResourceConcept[]

  chapterItems       ChapterItem[]
  questions          Question[]
  questionCandidates QuestionCandidate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isPublished])
  @@map("concepts")
}

model ConceptTradition {
  id         Int       @id @default(autoincrement())
  conceptId  Int
  concept    Concept   @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  tradition  Tradition
  definition String    @db.Text
  nuances    String?   @db.Text

  @@unique([conceptId, tradition])
  @@map("concept_traditions")
}

model ConceptClaim {
  conceptId Int
  concept   Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  claimId   Int
  claim     Claim   @relation(fields: [claimId], references: [id])
  position  Int     @default(0)

  @@id([conceptId, claimId])
  @@map("concept_claims")
}

// ─── TimelineEvent ────────────────────────────────────────────────────────────

model TimelineEvent {
  id           Int                      @id @default(autoincrement())
  slug         String                   @unique
  name         String
  era          TimelineEra
  position     Int
  summary      String?                  @db.Text
  isPublished  Boolean                  @default(false)
  searchVector Unsupported("tsvector")? @map("search_vector")

  traditions TimelineEventTradition[]
  verses     TimelineEventVerse[]
  figures    TimelineEventFigure[]

  chapterItems       ChapterItem[]
  questions          Question[]
  questionCandidates QuestionCandidate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([era, position])
  @@index([isPublished])
  @@map("timeline_events")
}

model TimelineEventTradition {
  id        Int               @id @default(autoincrement())
  eventId   Int
  event     TimelineEvent     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tradition Tradition
  presence  TraditionPresence
  notes     String?           @db.Text

  @@unique([eventId, tradition])
  @@map("timeline_event_traditions")
}

model TimelineEventVerse {
  eventId Int
  event   TimelineEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  verseId Int
  verse   Verse         @relation(fields: [verseId], references: [id])

  @@id([eventId, verseId])
  @@map("timeline_event_verses")
}

model TimelineEventFigure {
  eventId  Int
  event    TimelineEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  figureId Int
  figure   Figure        @relation(fields: [figureId], references: [id])

  @@id([eventId, figureId])
  @@map("timeline_event_figures")
}

// ═══════════════════════════════════════════════════════════════════════════
// LEARN — courses, chapters and quizzes
// ═══════════════════════════════════════════════════════════════════════════

enum ChapterItemType {
  CONCEPT
  COMPARISON
  FIGURE
  TIMELINE_EVENT
  THEME
}

/// Every kind is ATTRIBUTIVE by construction: the correct answer is a fact
/// about what a named tradition teaches, what a named text says, or where the
/// traditions differ. There is deliberately NO kind whose correct answer is an
/// unattributed truth claim — that absence is the neutrality guarantee.
enum QuestionKind {
  /// "What does <tradition> teach about X?" — requires subjectTradition.
  TRADITION_TEACHING
  /// "In Islamic tradition, who is Isa?" — requires subjectTradition.
  FIGURE_IDENTITY
  /// "According to <source>, what happens?" — requires a verse citation.
  SOURCE_TEXT
  /// "Which traditions affirm X?" — one option per tradition, none scored wrong.
  DIVERGENCE_MAP
  /// Ordering within a named tradition's narrative.
  TIMELINE_ORDER
  /// Definitional; provenance is a Concept.
  TERMINOLOGY
}

enum QuestionFormat {
  SINGLE_CHOICE
  MULTI_SELECT
  /// Never a bare true/false — the stem must attribute ("Islam teaches that…").
  TRUE_FALSE_ATTRIBUTED
  ORDERING
}

enum QuestionSourceType {
  CLAIM
  CONCEPT
  COMPARISON
  TIMELINE_EVENT
}

enum QuestionDifficulty {
  INTRO
  CORE
  DEEP
}

model Course {
  id          Int     @id @default(autoincrement())
  slug        String  @unique
  title       String
  subtitle    String?
  description String? @db.Text
  position    Int     @default(0)
  isPublished Boolean @default(false)

  chapters Chapter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, position])
  @@map("courses")
}

model Chapter {
  id       Int    @id @default(autoincrement())
  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  slug        String  @unique
  title       String
  summary     String? @db.Text
  position    Int     @default(0)
  isPublished Boolean @default(false)

  /// Human sign-off that this chapter's quiz is attributive. Required to
  /// publish — the automated lint is a speed bump, this is the real gate.
  neutralityReviewedAt DateTime?
  neutralityReviewNote String?   @db.Text

  quizQuestionCount Int @default(5)
  quizPassPercent   Int @default(70)

  items      ChapterItem[]
  questions  Question[]
  candidates QuestionCandidate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, position])
  @@index([courseId, position])
  @@index([isPublished])
  @@map("chapters")
}

/// One ordered playlist entry pointing at an existing entity.
///
/// Polymorphism is a discriminator + nullable typed FKs rather than a loose
/// entityId, so referential integrity survives. "Exactly one FK set, and it
/// matches itemType" is enforced by CHECK constraints in the migration SQL.
/// onDelete: Restrict — deleting a cited entity must fail loudly rather than
/// silently gutting a curated chapter.
model ChapterItem {
  id        Int     @id @default(autoincrement())
  chapterId Int
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  itemType ChapterItemType
  position Int             @default(0)
  /// Editorial framing shown above the embedded entity.
  note     String?         @db.Text

  conceptId       Int?
  concept         Concept?       @relation(fields: [conceptId], references: [id], onDelete: Restrict)
  comparisonId    Int?
  comparison      Comparison?    @relation(fields: [comparisonId], references: [id], onDelete: Restrict)
  figureId        Int?
  figure          Figure?        @relation(fields: [figureId], references: [id], onDelete: Restrict)
  timelineEventId Int?
  timelineEvent   TimelineEvent? @relation(fields: [timelineEventId], references: [id], onDelete: Restrict)
  themeId         Int?
  theme           Theme?         @relation(fields: [themeId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chapterId, position])
  @@index([itemType])
  @@map("chapter_items")
}

model Question {
  id        Int     @id @default(autoincrement())
  chapterId Int
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  kind       QuestionKind
  format     QuestionFormat     @default(SINGLE_CHOICE)
  difficulty QuestionDifficulty @default(CORE)
  position   Int                @default(0)

  prompt           String     @db.Text
  /// Whose teaching the question is about. Required for TRADITION_TEACHING and
  /// FIGURE_IDENTITY (CHECKed); null for kinds whose citation carries the
  /// attribution instead.
  subjectTradition Tradition?
  /// Required. A question cannot ship without stating why the answer is the
  /// answer; rendered with the provenance citation after answering.
  explanation      String     @db.Text

  isPublished Boolean @default(false)

  // ── provenance: exactly one, CHECKed ──────────────────────────────────
  sourceType      QuestionSourceType
  claimId         Int?
  claim           Claim?             @relation(fields: [claimId], references: [id], onDelete: Restrict)
  conceptId       Int?
  concept         Concept?           @relation(fields: [conceptId], references: [id], onDelete: Restrict)
  comparisonId    Int?
  comparison      Comparison?        @relation(fields: [comparisonId], references: [id], onDelete: Restrict)
  timelineEventId Int?
  timelineEvent   TimelineEvent?     @relation(fields: [timelineEventId], references: [id], onDelete: Restrict)

  /// Denormalised at author time from Comparison.isControversial or
  /// tag = CONTRADICTION. Narrows the allowed kinds and forces every option to
  /// name whose position it is.
  isContested Boolean @default(false)

  originCandidateId    Int?      @unique
  neutralityReviewedAt DateTime?
  neutralityReviewNote String?   @db.Text

  options QuestionAnswerOption[]
  verses  QuestionVerse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chapterId, position])
  @@index([isPublished])
  @@index([kind])
  @@map("questions")
}

model QuestionAnswerOption {
  id         Int      @id @default(autoincrement())
  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  text      String  @db.Text
  isCorrect Boolean @default(false)
  position  Int     @default(0)

  /// DIVERGENCE_MAP: which tradition this option represents and the presence
  /// it asserts, reusing the existing vocabulary so the answer key is
  /// checkable against real ConceptTradition / TimelineEventTradition rows.
  optionTradition Tradition?
  presence        TraditionPresence?

  /// Why this option is not that tradition's teaching. Required on contested
  /// questions so no distractor reads as "this tradition is simply mistaken".
  rationale String? @db.Text

  @@index([questionId, position])
  @@map("question_answer_options")
}

model QuestionVerse {
  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  verseId    Int
  verse      Verse    @relation(fields: [verseId], references: [id], onDelete: Restrict)
  position   Int      @default(0)

  @@id([questionId, verseId])
  @@map("question_verses")
}

/// AI-drafted question awaiting editorial review. Mirrors VerseLinkCandidate.
model QuestionCandidate {
  id        Int     @id @default(autoincrement())
  chapterId Int
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  kind             QuestionKind
  format           QuestionFormat @default(SINGLE_CHOICE)
  prompt           String         @db.Text
  subjectTradition Tradition?
  explanation      String         @db.Text

  sourceType      QuestionSourceType
  claimId         Int?
  claim           Claim?             @relation(fields: [claimId], references: [id])
  conceptId       Int?
  concept         Concept?           @relation(fields: [conceptId], references: [id])
  comparisonId    Int?
  comparison      Comparison?        @relation(fields: [comparisonId], references: [id])
  timelineEventId Int?
  timelineEvent   TimelineEvent?     @relation(fields: [timelineEventId], references: [id])

  /// Draft options as JSON while PENDING: review is a single-row write and a
  /// rejection leaves no orphan rows. Validated by zod on write and on promote.
  /// Shape: { text, isCorrect, optionTradition?, presence?, rationale? }[]
  proposedOptions Json

  aiRationale String  @db.Text
  aiModel     String?
  /// Dedupes re-generation, mirroring Claim.contentHash.
  contentHash String  @unique

  status          CandidateStatus @default(PENDING)
  reviewedAt      DateTime?
  reviewNotes     String?         @db.Text
  /// Result of the automated neutrality lint. A BLOCK flag disables Approve.
  neutralityFlags Json?

  createdAt DateTime @default(now())

  @@index([chapterId, status])
  @@index([status])
  @@map("question_candidates")
}

// ─── Kids section ────────────────────────────────────────────────────────────

enum KidsAgeBand {
  AGE_6_8
  AGE_9_12
}

model KidsStory {
  id          Int             @id @default(autoincrement())
  slug        String          @unique
  title       String
  ageBand     KidsAgeBand
  body        String          @db.Text
  glossary    Json?
  aiModel     String
  aiRationale String          @db.Text
  status      CandidateStatus @default(PENDING)
  reviewedAt  DateTime?
  reviewNotes String?         @db.Text
  isPublished Boolean         @default(false)

  claims  KidsStoryClaim[]
  figures KidsStoryFigure[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([isPublished, ageBand])
  @@map("kids_stories")
}

model KidsStoryClaim {
  storyId  Int
  story    KidsStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  claimId  Int
  claim    Claim     @relation(fields: [claimId], references: [id], onDelete: Cascade)
  position Int       @default(0)

  @@id([storyId, claimId])
  @@map("kids_story_claims")
}

model KidsStoryFigure {
  storyId  Int
  story    KidsStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  figureId Int
  figure   Figure    @relation(fields: [figureId], references: [id], onDelete: Cascade)

  @@id([storyId, figureId])
  @@map("kids_story_figures")
}

// ─── Video resources ─────────────────────────────────────────────────────────

model VideoResource {
  id                   Int        @id @default(autoincrement())
  youtubeId            String     @unique
  title                String
  channelName          String
  editorNote           String     @db.Text
  perspectiveTradition Tradition?
  durationSeconds      Int?
  isPublished          Boolean    @default(false)
  isKidsSafe           Boolean    @default(false)

  concepts VideoResourceConcept[]
  figures  VideoResourceFigure[]
  themes   VideoResourceTheme[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished])
  @@map("video_resources")
}

model VideoResourceConcept {
  videoId   Int
  video     VideoResource @relation(fields: [videoId], references: [id], onDelete: Cascade)
  conceptId Int
  concept   Concept       @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  position  Int           @default(0)

  @@id([videoId, conceptId])
  @@map("video_resource_concepts")
}

model VideoResourceFigure {
  videoId  Int
  video    VideoResource @relation(fields: [videoId], references: [id], onDelete: Cascade)
  figureId Int
  figure   Figure        @relation(fields: [figureId], references: [id], onDelete: Cascade)
  position Int           @default(0)

  @@id([videoId, figureId])
  @@map("video_resource_figures")
}

model VideoResourceTheme {
  videoId  Int
  video    VideoResource @relation(fields: [videoId], references: [id], onDelete: Cascade)
  themeId  Int
  theme    Theme         @relation(fields: [themeId], references: [id], onDelete: Cascade)
  position Int           @default(0)

  @@id([videoId, themeId])
  @@map("video_resource_themes")
}
